   "fieldname": "media_specification",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Media Specification",
   "options": "Media Specification",
   "read_only_depends_on": "eval:!doc.__islocal;",
   "reqd": 1
  },
  {
   "description": "Exact Workflow Version inherited from the Media Specification.",
   "fieldname": "workflow_version",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Workflow Version",
   "options": "Workflow Version",
   "read_only_depends_on": "eval:!doc.__islocal;",
   "reqd": 1
  },
  {
   "description": "Stable worker-routing key. Derived from the Workflow Version so jobs using the same model can stay on a warm worker.",
   "fieldname": "model_cache_key",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Model Cache Key",
   "read_only": 1
  },
  {
   "default": "Draft",
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Status",
   "options": "Draft\nReady\nQueued\nRunning\nCompleted\nPartially Completed\nFailed\nCancelled",
   "reqd": 1
  },
  {
   "default": "__user",
   "fieldname": "requested_by",
   "fieldtype": "Link",
   "label": "Requested By",
