   "reqd": 1
  },
  {
   "fieldname": "execution_section",
   "fieldtype": "Section Break",
   "label": "Execution"
  },
  {
   "fieldname": "queued_at",
   "fieldtype": "Datetime",
   "label": "Queued At",
   "read_only": 1
  },
  {
   "fieldname": "started_at",
   "fieldtype": "Datetime",
   "label": "Started At",
   "read_only": 1
  },
  {
   "fieldname": "completed_at",
   "fieldtype": "Datetime",
   "label": "Completed At",
   "read_only": 1
  },
  {
   "fieldname": "error_summary",
