{
  "doctype": "Generation Workflow",
  "workflow_key": "studio_finish",
  "adapter_key": "comfyui_generic",
  "output_media_type": "Video",
  "primary_output_node_key": "joymedia_save",
  "frame_count": 60,
  "output_fps": 60,
  "produces_video": 1,
  "produces_audio": 0,
  "workflow_json": {
    "load": {
      "class_type": "VHS_LoadVideo",
      "inputs": {
        "video": "input.mp4",
        "force_rate": 0,
        "custom_width": 0,
        "custom_height": 0,
        "frame_load_cap": 0,
        "skip_first_frames": 0,
        "select_every_nth": 1,
        "format": "None"
      }
    },
    "upscale_model": {
      "class_type": "UpscaleModelLoader",
      "inputs": {
        "model_name": "RealESRGAN_x2.pth"
      }
    },
    "upscale": {
      "class_type": "ImageUpscaleWithModel",
      "inputs": {
        "upscale_model": [
          "upscale_model",
          0
        ],
        "image": [
          "load",
          0
        ]
      }
    },
    "interp_model": {
      "class_type": "FrameInterpolationModelLoader",
      "inputs": {
        "model_name": "rife_v4.26.safetensors"
      }
    },
    "interpolate": {
      "class_type": "FrameInterpolate",
      "inputs": {
        "interp_model": [
          "interp_model",
          0
        ],
        "images": [
          "upscale",
          0
        ],
        "multiplier": 5
      }
    },
    "select": {
      "class_type": "VHS_SelectEveryNthImage",
      "inputs": {
        "images": [
          "interpolate",
          0
        ],
        "select_every_nth": 2,
        "skip_first_images": 0
      }
    },
    "trim": {
      "class_type": "ImageFromBatch",
      "inputs": {
        "image": [
          "select",
          0
        ],
        "batch_index": 0,
        "length": 60
      }
    },
    "joymedia_save": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "images": [
          "trim",
          0
        ],
        "frame_rate": 60.0,
        "loop_count": 0,
        "filename_prefix": "joymedia/finish",
        "format": "video/h264-mp4",
        "pix_fmt": "yuv420p",
        "crf": 12,
        "save_metadata": false,
        "pingpong": false,
        "save_output": false
      }
    }
  },
  "execution_spec": {
    "parameters": [
      {
        "semantic": "frame_count",
        "node_key": "trim",
        "input_name": "length"
      },
      {
        "semantic": "fps",
        "node_key": "joymedia_save",
        "input_name": "frame_rate"
      },
      {
        "semantic": "output_prefix",
        "node_key": "joymedia_save",
        "input_name": "filename_prefix"
      }
    ],
    "outputs": {
      "primary": {
        "node_key": "joymedia_save",
        "media_type": "Video"
      }
    },
    "finishing": {
      "scale": 2,
      "output_fps": 60,
      "source_fps": 24,
      "chunk_frames": 24,
      "delivery_scale": 1.3333333333333333,
      "interpolation_multiplier": 5,
      "selection_stride": 2
    },
    "metadata": {
      "frame_count": 60,
      "output_fps": 60,
      "produces_video": 1,
      "produces_audio": 0
    }
  },
  "bindings": [
    {
      "binding_key": "source_video",
      "node_key": "load",
      "input_name": "video",
      "required_input_role": "source_video",
      "value_type": "File Path",
      "accepted_media_type": "Video",
      "required": 1
    }
  ],
  "primary_artifact_role": "Primary Video"
}
