[Unit]
Description=JoyMedia Qwen OpenAI-Compatible Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu
ExecStart=/home/ubuntu/qwen_env/bin/python /home/ubuntu/qwen_env/bin/vllm serve /home/ubuntu/models/Qwen2.5-VL-72B-AWQ --served-model-name joymedia-qwen --host 127.0.0.1 --port 8001 --dtype auto --gpu-memory-utilization 0.55 --max-model-len 16384
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
