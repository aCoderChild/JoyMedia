[Unit]
Description=JoyMedia demo scheduler
After=mariadb.service redis-server.service
Wants=mariadb.service redis-server.service
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/joymedia-demo-staging/bench/sites
ExecStart=/home/ubuntu/joymedia-demo-staging/env/bin/python -m frappe.utils.bench_helper frappe schedule
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
