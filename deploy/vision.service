[Unit]
Description=JoyMedia Qwen vision-language OpenAI-Compatible Server
After=network-online.target joymedia-qwen.service
Wants=network-online.target joymedia-qwen.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu
Environment=VLLM_USE_FLASHINFER_SAMPLER=0
# Reserve the planner's VRAM allocation first; systemd's After= only orders process start.
ExecStartPre=/bin/sh -c 'for i in $$(seq 1 180); do curl -fsS http://127.0.0.1:8001/v1/models >/dev/null && exit 0; sleep 1; done; exit 1'
ExecStart=/home/ubuntu/venvs/joymedia-qwen/bin/vllm serve /home/ubuntu/models_qwen/Qwen2.5-VL-7B-Instruct-AWQ --served-model-name joymedia-vl --host 127.0.0.1 --port 8002 --quantization awq --dtype half --max-model-len 2048 --gpu-memory-utilization 0.24
StandardOutput=append:/home/ubuntu/vision-systemd.log
StandardError=append:/home/ubuntu/vision-systemd.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
