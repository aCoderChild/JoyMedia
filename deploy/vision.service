[Unit]
Description=JoyMedia vision runtime profile
After=network-online.target joymedia-planner.service
Wants=network-online.target joymedia-planner.service

[Service]
Type=simple
User=ubuntu
# Reserve the planner's declared resources before loading this profile.
ExecStartPre=/usr/local/lib/joymedia/run-profile.py --timeout 600 --wait planner
ExecStart=/usr/local/lib/joymedia/run-profile.py vision
TimeoutStartSec=660
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
