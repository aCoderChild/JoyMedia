# Install as /etc/joymedia/deploy.env, owned by root, readable by the Bench deploy user.
# The Bench and JoyMedia checkout live on the existing GPU server during this phase.
BENCH_DIR=/srv/frappe-bench
SITE=joymedia.example.com
BACKUP_ROOT=/srv/joymedia-backups
HEALTH_URL=http://127.0.0.1:8000/joymedia
COMFY_HEALTH_URL=http://127.0.0.1:8188/system_stats
MIN_WORKERS=4
MIN_BACKUP_FREE_KB=20971520
